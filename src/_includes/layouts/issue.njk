---
layout: layouts/base.njk
---
{% from "components/ui.njk" import pageHeader, issueViewer with context %}
{{ pageHeader(title, summary, date | readableDate) }}
<div class="wrap page-body">
  {%- for issue in collections.issues %}{% if issue.url == page.url %}{{ issueViewer(issue, content, 2) }}{% endif %}{% endfor %}
  <p class="more"><a href="/newsletter/">All newsletters</a></p>
</div>
