{#- Drawing title block. "Sheet" is the current page, so every page labels itself. -#}
<footer class="site-footer">
  <div class="wrap">
    <div class="tb">
      <div class="tb__id">
        <a href="/"><img src="{{ logos.logoHorizontalDark }}" alt="Team Resistance, FRC Team 86, home" height="30"></a>
        <p class="tb__sheet"><span>Sheet</span>{{ title if (title and page.url != "/") else "Home" }}</p>
      </div>
      <dl class="tb__grid">
        <div><dt>Team</dt><dd>{{ site.team }}</dd></div>
        <div><dt>Organization</dt><dd>{{ site.org.legalName }}</dd></div>
        <div><dt>Status</dt><dd>501(c)(3), EIN {{ site.org.ein }}</dd></div>
        <div><dt>Since</dt><dd>{{ site.founded }}</dd></div>
        <div class="wide"><dt>Address</dt><dd>{{ site.org.address | join(", ") }}</dd></div>
        <div class="wide"><dt>Follow</dt><dd>
          {%- for s in site.social | selectattr("url") %}{% if not loop.first %}, {% endif %}<a href="{{ s.url }}" rel="noopener me">{{ s.label }}</a>{% endfor %}
        </dd></div>
      </dl>
      <nav class="tb__nav" aria-label="Footer">
        <ul role="list">
          <li><a href="/about-team-resistance/">About</a></li>
          <li><a href="/history/">Robots</a></li>
          <li><a href="/awards/">Awards</a></li>
          <li><a href="/sponsors/">Sponsors</a></li>
          <li><a href="/newsletter/">Newsletter</a></li>
          {%- for r in collections.resources %}<li><a href="{{ r.url }}">{{ r.data.navLabel or r.data.title }}</a></li>{% endfor %}
          <li><a href="/contact/">Contact</a></li>
          <li><a href="{{ site.links.brand }}" rel="noopener">Brand guidelines<span class="vh"> (external site)</span></a></li>
        </ul>
      </nav>
    </div>
    <p class="site-footer__legal">© {{ build.year }} {{ site.org.legalName }} FIRST® and FIRST Robotics Competition are registered trademarks of FIRST.</p>
  </div>
</footer>
